{
  "project_name": "url-shortener-app",
  "models": [
    "User",
    "Url"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text"
    },
    "Url": {
      "original_url": "string",
      "short_url": "string",
      "user_id": "integer"
    }
  },
  "migrations": [
    "create_users_table",
    "create_urls_table",
    "create_user_urls_table"
  ],
  "livewire_components": [
    "user-profile",
    "url-list",
    "url-create"
  ],
  "seeders": [
    "UserSeeder",
    "UrlSeeder"
  ],
  "factories": [
    "UserFactory",
    "UrlFactory"
  ],
  "routes": [
    "/dashboard",
    "/urls",
    "/urls/create"
  ],
  "pivot_tables": [
    "user_urls"
  ],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "Url"
    },
    {
      "model": "Url",
      "type": "belongsTo",
      "target": "User"
    }
  ]
}
