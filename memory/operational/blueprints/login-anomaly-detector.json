{
  "project_name": "login-anomaly-detector",
  "models": [
    "User",
    "AnomalyDetectionModel"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string:unique",
      "password": "text",
      "role": "string:default(user)"
    },
    "AnomalyDetectionModel": {
      "username": "string",
      "email": "string:unique",
      "password": "text",
      "description": "text:nullable",
      "user_id": "foreignUuid:constrained"
    }
  },
  "migrations": [
    "create_users_table",
    "create_anomaly_detection_models_table"
  ],
  "livewire_components": [
    "anomaly-detection-form",
    "anomaly-detection-results"
  ],
  "seeders": [
    "UserSeeder",
    "AnomalyDetectionModelSeeder"
  ],
  "factories": [
    "UserFactory",
    "AnomalyDetectionModelFactory"
  ],
  "routes": [
    "/dashboard",
    "/anomaly-detector"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "AnomalyDetectionModel"
    }
  ],
  "middleware": [
    "auth",
    "verified",
    "throttle:60,1"
  ],
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/api/v1/anomaly-detector",
      "controller": "AnomalyDetectionController@index",
      "middleware": [
        "auth:sanctum"
      ]
    },
    {
      "method": "POST",
      "path": "/api/v1/anomaly-detector",
      "controller": "AnomalyDetectionController@store",
      "middleware": [
        "auth:sanctum"
      ]
    }
  ],
  "security_policies": {
    "roles": [
      "admin",
      "user"
    ],
    "permissions": [
      "manage-anomaly-detections",
      "view-dashboard"
    ],
    "rate_limiting": {
      "api": "60,1",
      "auth": "5,1"
    },
    "middleware_map": {
      "/admin/*": [
        "auth",
        "role:admin"
      ],
      "/dashboard": [
        "auth",
        "verified"
      ]
    }
  },
  "async_jobs": [
    {
      "name": "ProcessAnomalyTask",
      "queue": "default",
      "retry": 3,
      "backoff": 60
    }
  ],
  "ui_design_system": {
    "color_palette": {
      "primary": "#4f46e5",
      "secondary": "#64748b",
      "accent": "#f59e0b",
      "background": "#f8fafc",
      "surface": "#ffffff"
    },
    "typography": {
      "heading_font": "Inter",
      "body_font": "Inter",
      "scale": "1.25"
    },
    "layout": "sidebar-main",
    "theme": "light",
    "component_style": "rounded-2xl shadow-sm border border-slate-200"
  },
  "_readmeHash": "30994aa1d8206cc85cbf64970086ac96"
}
