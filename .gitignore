# 🛡️ NEXUS AI: GITIGNORE PROTOCOL
# Standardized for Phase 5 (Knowledge Shelving)

# --- Dependencies ---
node_modules/
jspm_packages/
.pnp*
.pnp.js
venv/
.venv/
__pycache__/
*.pyc

# --- Environment & Sensitive ---
.env
.env.*
*.local
*.secret

# --- OS & IDEs ---
.DS_Store
Thumbs.db
.idea/
.vscode/
.qoder/
*.swp
*.swo
*.tmp
*.temp

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
logs/

# --- Sandbox Dependencies ---
tests/sandboxes/*/vendor/
tests/sandboxes/*/node_modules/

# --- Nexus Ingestion & Transit (CLEAN REPO) ---
# Ignore the harvest area as it is a temporary transit folder
golden/harvest/*
!golden/harvest/.gitkeep

# Ignore scratch files and temporary test scripts
scratch/
tests/sandboxes/*
!tests/sandboxes/url-shortener/
tests/tmp/
tests/coverage/

# --- Nexus Memory Management ---
# Short Term Memory (Audit/Planning results that are not yet archived)
memory/short_term/audit/*
memory/short_term/planning/*
memory/short_term/records/*
memory/short_term/summary/*
memory/short_term/cache/
!memory/short_term/**/*.gitkeep

# Keep the Long Term HUB (Knowledge racks)
# !memory/long_term/

# --- Nexus Agent Skills & Config ---
# Kita ingin melacak file SKILL.md tapi mungkin ingin mengabaikan cache lokal agent
.agents/

# --- Documentation (Legacy Folders) ---
# Since we now use the HUB, we only keep .md files if specifically needed
# but generally we want to keep the documentation folder clean
documentation/audit/*
documentation/planning/*
documentation/records/*
documentation/summary/*
documentation/algorithms/*
documentation/legal/*
!documentation/**/*.md
!documentation/**/.gitkeep

# --- Build & Output ---
dist/
build/
out/
bin/
NEXUS_PUBLIC_DISTRIBUTION/

# --- Nexus Session Archives & Runtime Artifacts ---
# Ignore session history archives that are generated during runtime
knowledge/*_SESSION_HISTORY_ARCHIVE.md
knowledge/*_LOG.md
memory/distilled/performance/*.MD
memory/operational/records/*.json

# --- NEXUS Generated Artifacts (regenerated at runtime, never version) ---
# Root blueprint written by blueprintApp() when rootPath == repo root
NEXUS_BLUEPRINT.json
# Generated graph/vector cache index (volatile, large). NOTE: correct path is
# under memory/distilled/short_term, not memory/short_term as the old rule above.
memory/distilled/short_term/cache/
# Per-project blueprint JSONs produced by Phase 0.5 scaffolding
memory/operational/blueprints/

# --- Mass Cleanup (2026-10-12): runtime caches & vendored bundles, untracked ---
# Vendored third-party skill bundles (moved into Obsidian Vault, not versioned).
memory/references/
# Machine-specific Obsidian vault pointer (absolute local path; keep local only).
.nexus-vault.json
# Local sandbox crash screenshots & session logs (manual notes, not versioned).
images nexus sandbox/
# Volatile graph index rebuilt by the agent at runtime (kept as wildcard so the
# rule is path-independent across memory/distilled/short_term/cache/ and
# memory/short_term/cache/).
**/nexus_graph_index.json
# Legacy short_term link_cache / vector_index paths (retained for backwards
# safety; today the live file is memory/operational/link_cache.json — see the
# NEXUS Operational Runtime Artifacts block below).
memory/short_term/link_cache.json
memory/short_term/vector_index.json

# --- NEXUS Operational Runtime Artifacts (regenerated every agent cycle) ---
# Written by Distiller / MemoryGovernor under memory/operational/ on each run.
# These were versioned by mistake; the previous short_term/link_cache rule
# pointed at the wrong path. Adding precise rules here + `git rm --cached` on
# the currently-tracked files so future cycles don't dirty git status.
memory/operational/link_cache.json
memory/operational/session_*.json
memory/operational/archive_index.json
memory/operational/indexes/
memory/operational/semantic/
# Per-run ingestion outputs in memory/raw (timestamped, rebuilt each audit).
memory/raw/audit_SUMMARY_*.json
memory/raw/report_*_AUDIT-*.json

# --- Large Model Files ---
models/
*.gguf
# Human-AI Nexus
nexus/

# Nexus Agent Cache
agent/memory/cache/
memory/cache/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
