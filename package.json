{
  "name": "nexus",
  "version": "3.4.0",
  "description": "Documentation-First Framework for Human-AI Collaborative Development",
  "keywords": [
    "ai",
    "orchestration",
    "documentation",
    "framework",
    "nexus",
    "tdd",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Faisal-Trainer/Human-AI-Nexus"
  },
  "license": "MIT",
  "author": "Faisal-Trainer",
  "type": "commonjs",
  "main": "cli.js",
  "bin": {
    "nexus": "cli.js"
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "bun cli.js run",
    "refactor": "bun cli.js refactor",
    "update-skills": "bun cli.js update-skills",
    "test": "bun tests/TDD/runner.js",
    "lint": "eslint agent/ cli.js tests/TDD/*.js",
    "sync-version": "bun -e \"const p=require('./package.json'); const pp=require('./NEXUS_PUBLIC_DISTRIBUTION/package.json'); pp.version=p.version; require('fs').writeFileSync('./NEXUS_PUBLIC_DISTRIBUTION/package.json', JSON.stringify(pp,null,2))\"",
    "graphify": "graphify"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "chalk": "^4.1.2",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.1.0",
    "natural": "^8.1.1",
    "node-llama-cpp": "^3.18.1",
    "redis": "^5.12.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sentropic/graphify": "^0.17.1",
    "@types/node": "^25.9.1",
    "eslint": "^8.56.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.1.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
