{
  "project_name": "url-shortener-app",
  "models": [
    "User",
    "ShortenedUrl"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string:unique",
      "password": "text",
      "role": "string:default(user)"
    },
    "ShortenedUrl": {
      "original_url": "string",
      "shortened_code": "string:unique",
      "created_at": "datetime",
      "updated_at": "datetime",
      "user_id": "integer",
      "redirects_count": "integer",
      "status": "string:default(active)"
    }
  },
  "migrations": [
    "create_users_table",
    "create_shortened_urls_table"
  ],
  "livewire_components": [
    "shortened-url-form",
    "shortened-url-list"
  ],
  "seeders": [
    "UserSeeder",
    "ShortenedUrlSeeder"
  ],
  "factories": [
    "UserFactory",
    "ShortenedUrlFactory"
  ],
  "routes": [
    "/shortened-url",
    "/shortened-url/{shortened_code}",
    "/{shortCode}"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "ShortenedUrl"
    }
  ],
  "middleware": [
    "auth",
    "verified",
    "throttle:60,1"
  ],
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/api/v1/shortened-url",
      "controller": "ShortenedUrlController@index",
      "middleware": [
        "auth:sanctum"
      ]
    },
    {
      "method": "POST",
      "path": "/api/v1/shortened-url",
      "controller": "ShortenedUrlController@store",
      "middleware": [
        "auth:sanctum"
      ]
    },
    {
      "method": "PUT",
      "path": "/api/v1/shortened-url/{shortened_code}",
      "controller": "ShortenedUrlController@update",
      "middleware": [
        "auth:sanctum"
      ]
    }
  ],
  "security_policies": {
    "roles": [
      "admin",
      "user"
    ],
    "permissions": [
      "manage-shortened-urls",
      "view-dashboard"
    ],
    "rate_limiting": {
      "api": "60,1",
      "auth": "5,1"
    },
    "middleware_map": {
      "/admin/*": [
        "auth",
        "role:admin"
      ],
      "/dashboard": [
        "auth",
        "verified"
      ]
    }
  },
  "async_jobs": [
    {
      "name": "ProcessReport",
      "queue": "default",
      "retry": 3,
      "backoff": 60
    }
  ],
  "ui_design_system": {
    "color_palette": {
      "primary": "#1e40af",
      "secondary": "#64748b",
      "accent": "#f59e0b",
      "background": "#f8fafc",
      "surface": "#ffffff"
    },
    "typography": {
      "heading_font": "Inter",
      "body_font": "Inter",
      "scale": "1.25"
    },
    "layout": "sidebar-main",
    "theme": "light",
    "component_style": "rounded-xl shadow-sm border border-gray-200"
  },
  "_readmeHash": "a866dcd1dedeeb6ac721d92edc5650e7"
}
