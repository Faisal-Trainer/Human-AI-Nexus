{
  "project_name": "notes-app-tagging",
  "architecture_stack": {
    "backend": "Laravel",
    "frontend": "Livewire + Tailwind",
    "database": "MySQL"
  },
  "models": [
    "User",
    "Note",
    "Tag"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text"
    },
    "Note": {
      "title": "string",
      "content": "text",
      "created_at": "datetime",
      "user_id": "integer"
    },
    "Tag": {
      "name": "string",
      "created_at": "datetime"
    }
  },
  "migrations": [
    "create_users_table",
    "create_notes_table",
    "create_tags_table"
  ],
  "livewire_components": [
    "note-list",
    "note-create",
    "note-edit",
    "tag-list"
  ],
  "seeders": [
    "UserSeeder",
    "NoteSeeder",
    "TagSeeder"
  ],
  "factories": [
    "UserFactory",
    "NoteFactory",
    "TagFactory"
  ],
  "routes": [
    "/dashboard",
    "/notes",
    "/tags"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "Note",
      "type": "belongsTo",
      "target": "User"
    },
    {
      "model": "Note",
      "type": "hasMany",
      "target": "Tag"
    },
    {
      "model": "Note",
      "type": "belongsToMany",
      "target": "Tag",
      "pivot_table": "note_tag"
    }
  ],
  "presentation_layer": {
    "layouts": [
      "app",
      "guest",
      "admin"
    ],
    "components": [
      {
        "name": "note-list",
        "state": [
          "notes",
          "searchQuery"
        ],
        "events_listened": [
          "noteCreated"
        ]
      },
      {
        "name": "note-create",
        "state": [
          "note"
        ],
        "events_listened": [
          "noteCreated"
        ]
      },
      {
        "name": "note-edit",
        "state": [
          "note"
        ],
        "events_listened": [
          "noteCreated"
        ]
      },
      {
        "name": "tag-list",
        "state": [
          "tags"
        ],
        "events_listened": [
          "tagCreated"
        ]
      }
    ]
  },
  "business_logic": {
    "roles": [
      "admin",
      "user"
    ],
    "policies": [
      "NotePolicy: User can only edit own note"
    ],
    "validation_rules": {
      "User": [
        "email:required|unique"
      ],
      "Note": [
        "title:required",
        "content:required"
      ]
    }
  },
  "integrations": [
    "Mailgun",
    "S3"
  ],
  "testing": {
    "feature_tests": [
      "UserRegistrationTest",
      "CreateNoteTest"
    ],
    "unit_tests": [
      "NoteStatusCalculationTest"
    ]
  }
}
