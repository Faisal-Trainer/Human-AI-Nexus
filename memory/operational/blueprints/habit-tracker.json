{
  "project_name": "habit-tracker",
  "models": [
    "User",
    "Habit"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text",
      "habits": [
        {
          "name": "string",
          "created_at": "datetime",
          "updated_at": "datetime"
        }
      ]
    }
  },
  "migrations": [
    "create_users_table",
    "create_habits_table"
  ],
  "livewire_components": [
    "user-profile",
    "habit-show"
  ],
  "seeders": [
    "UserSeeder",
    "HabitSeeder"
  ],
  "factories": [
    "UserFactory",
    "HabitFactory"
  ],
  "routes": [
    "/dashboard",
    "/user/{id}/habits"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "Habit"
    }
  ]
}
