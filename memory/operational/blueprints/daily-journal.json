{
  "project_name": "daily-journal",
  "architecture_stack": {
    "backend": "Laravel",
    "frontend": "Livewire + Tailwind",
    "database": "MySQL"
  },
  "models": [
    "User",
    "Post"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text",
      "posts": "hasMany"
    },
    "Post": {
      "title": "string",
      "content": "text",
      "user_id": "integer",
      "created_at": "datetime",
      "updated_at": "datetime"
    }
  },
  "migrations": [
    "create_users_table",
    "create_posts_table"
  ],
  "livewire_components": [
    "user-profile",
    "post-list",
    "post-form"
  ],
  "seeders": [
    "UserSeeder",
    "PostSeeder"
  ],
  "factories": [
    "UserFactory",
    "PostFactory"
  ],
  "routes": [
    "/dashboard",
    "/posts",
    "/post/create"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "Post"
    },
    {
      "model": "Post",
      "type": "belongsTo",
      "target": "User"
    }
  ],
  "presentation_layer": {
    "layouts": [
      "app",
      "guest",
      "admin"
    ],
    "components": [
      {
        "name": "user-profile",
        "state": [
          "user",
          "profile"
        ],
        "events_listened": [
          "userUpdated"
        ]
      },
      {
        "name": "post-list",
        "state": [
          "posts",
          "searchQuery"
        ],
        "events_listened": [
          "postCreated"
        ]
      },
      {
        "name": "post-form",
        "state": [
          "post",
          "form"
        ],
        "events_listened": [
          "postSaved"
        ]
      }
    ]
  },
  "business_logic": {
    "roles": [
      "admin",
      "user"
    ],
    "policies": [
      "PostPolicy: User can only edit own post"
    ],
    "validation_rules": {
      "User": [
        "email:required|unique"
      ],
      "Post": [
        "title:required",
        "content:required"
      ]
    }
  },
  "integrations": [
    "Mailgun",
    "S3"
  ],
  "testing": {
    "feature_tests": [
      "UserRegistrationTest",
      "CreatePostTest"
    ],
    "unit_tests": [
      "PostStatusCalculationTest"
    ]
  }
}
