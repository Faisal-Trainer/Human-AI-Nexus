{
  "project_name": "url-shortener-app",
  "models": [
    "User",
    "ShortUrl"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text"
    },
    "ShortUrl": {
      "url": "string",
      "shortened_url": "string",
      "user_id": "integer"
    }
  },
  "migrations": [
    "create_users_table",
    "create_short_urls_table"
  ],
  "livewire_components": [
    "user-profile",
    "short-url-preview"
  ],
  "seeders": [
    "UserSeeder",
    "ShortUrlSeeder"
  ],
  "factories": [
    "UserFactory",
    "ShortUrlFactory"
  ],
  "routes": [
    "/dashboard",
    "/short-url/new",
    "/short-url/{shortened_url}"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "ShortUrl"
    }
  ]
}
