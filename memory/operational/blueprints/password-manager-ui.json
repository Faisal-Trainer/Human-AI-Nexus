{
  "project_name": "password-manager-ui",
  "architecture_stack": {
    "backend": "Laravel",
    "frontend": "Livewire + Tailwind",
    "database": "MySQL"
  },
  "models": [
    "User",
    "Password"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text"
    },
    "Password": {
      "user_id": "integer",
      "password": "string"
    }
  },
  "migrations": [
    "create_users_table",
    "create_passwords_table"
  ],
  "livewire_components": [
    "user-profile",
    "password-form"
  ],
  "seeders": [
    "UserSeeder",
    "PasswordSeeder"
  ],
  "factories": [
    "UserFactory",
    "PasswordFactory"
  ],
  "routes": [
    "/dashboard",
    "/password"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "Password"
    }
  ],
  "presentation_layer": {
    "layouts": [
      "app",
      "guest",
      "admin"
    ],
    "components": [
      {
        "name": "user-profile",
        "state": [
          "user",
          "password"
        ],
        "events_listened": [
          "passwordUpdated"
        ]
      }
    ]
  },
  "business_logic": {
    "roles": [
      "admin",
      "user"
    ],
    "policies": [
      "PasswordPolicy: User can only edit own password"
    ],
    "validation_rules": {
      "User": [
        "email:required|unique"
      ],
      "Password": [
        "password:required"
      ]
    }
  },
  "integrations": [
    "Mailgun",
    "S3"
  ],
  "testing": {
    "feature_tests": [
      "UserRegistrationTest",
      "PasswordUpdateTest"
    ],
    "unit_tests": [
      "PasswordStatusCalculationTest"
    ]
  }
}
