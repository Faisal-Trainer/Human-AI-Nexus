{
  "project_name": "bookmark-manager",
  "models": [
    "User",
    "Bookmark"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text"
    },
    "Bookmark": {
      "title": "string",
      "url": "string"
    }
  },
  "migrations": [
    "create_users_table",
    "create_bookmarks_table"
  ],
  "livewire_components": [
    "user-profile",
    "bookmark-list"
  ],
  "seeders": [
    "UserSeeder",
    "BookmarkSeeder"
  ],
  "factories": [
    "UserFactory",
    "BookmarkFactory"
  ],
  "routes": [
    "/dashboard",
    "/bookmarks"
  ],
  "pivot_tables": [
    "bookmark_user"
  ],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "Bookmark"
    },
    {
      "model": "Bookmark",
      "type": "belongsTo",
      "target": "User"
    }
  ]
}
