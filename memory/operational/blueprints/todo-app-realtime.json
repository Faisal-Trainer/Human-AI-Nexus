{
  "project_name": "todo-app-realtime",
  "models": [
    "User",
    "Task"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text",
      "tasks": "relation"
    },
    "Task": {
      "title": "string",
      "description": "string",
      "completed": "boolean",
      "user": "relation"
    }
  },
  "migrations": [
    "create_users_table",
    "create_tasks_table"
  ],
  "livewire_components": [
    "user-profile",
    "task-list"
  ],
  "seeders": [
    "UserSeeder",
    "TaskSeeder"
  ],
  "factories": [
    "UserFactory",
    "TaskFactory"
  ],
  "routes": [
    "/dashboard",
    "/tasks"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "Task"
    }
  ]
}
