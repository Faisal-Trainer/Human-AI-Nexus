{
  "project_name": "todo-app-realtime",
  "architecture_stack": {
    "backend": "Laravel",
    "frontend": "Livewire + Tailwind",
    "database": "MySQL"
  },
  "models": [
    "User",
    "Task"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "string",
      "tasks": []
    }
  },
  "migrations": [
    "create_users_table",
    "create_tasks_table"
  ],
  "livewire_components": [
    "user-profile",
    "task-list"
  ],
  "seeders": [
    "UserSeeder",
    "TaskSeeder"
  ],
  "factories": [
    "UserFactory",
    "TaskFactory"
  ],
  "routes": [
    "/dashboard",
    "/tasks"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "Task"
    }
  ],
  "presentation_layer": {
    "layouts": [
      "app",
      "guest",
      "admin"
    ],
    "components": [
      {
        "name": "user-profile",
        "state": [
          "user",
          "tasks"
        ],
        "events_listened": [
          "taskCreated"
        ]
      },
      {
        "name": "task-list",
        "state": [
          "tasks",
          "searchQuery"
        ],
        "events_listened": [
          "taskCreated",
          "taskUpdated"
        ]
      }
    ]
  },
  "business_logic": {
    "roles": [
      "admin",
      "user"
    ],
    "policies": [
      "TaskPolicy: User can only edit own task"
    ],
    "validation_rules": {
      "User": [
        "email:required|unique"
      ],
      "Task": [
        "title:required",
        "description:required"
      ]
    }
  },
  "integrations": [
    "Mailgun",
    "S3"
  ],
  "testing": {
    "feature_tests": [
      "UserRegistrationTest",
      "CreateTaskTest"
    ],
    "unit_tests": [
      "TaskStatusCalculationTest"
    ]
  }
}
