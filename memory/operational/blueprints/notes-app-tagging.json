{
  "project_name": "notes-app-tagging",
  "models": [
    "User",
    "Note"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string:unique",
      "password": "text",
      "role": "string:default(user)"
    },
    "Note": {
      "title": "string",
      "description": "text:nullable",
      "user_id": "foreignUuid:constrained",
      "tags": "json"
    }
  },
  "migrations": [
    "create_users_table",
    "create_notes_table"
  ],
  "livewire_components": [
    "note-list",
    "note-show"
  ],
  "seeders": [
    "UserSeeder",
    "NoteSeeder"
  ],
  "factories": [
    "UserFactory",
    "NoteFactory"
  ],
  "routes": [
    "/dashboard",
    "/notes"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "Note"
    }
  ],
  "middleware": [
    "auth",
    "verified"
  ],
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/api/v1/notes",
      "controller": "NoteController@index",
      "middleware": [
        "auth:sanctum"
      ]
    },
    {
      "method": "POST",
      "path": "/api/v1/notes",
      "controller": "NoteController@store",
      "middleware": [
        "auth:sanctum"
      ]
    }
  ],
  "security_policies": {
    "roles": [
      "admin",
      "user"
    ],
    "permissions": [
      "manage-notes",
      "view-dashboard"
    ],
    "rate_limiting": {
      "api": "60,1",
      "auth": "5,1"
    },
    "middleware_map": {
      "/admin/*": [
        "auth",
        "role:admin"
      ],
      "/dashboard": [
        "auth",
        "verified"
      ]
    }
  },
  "async_jobs": [
    {
      "name": "CreateNoteTag",
      "queue": "default",
      "retry": 3,
      "backoff": 60
    }
  ],
  "ui_design_system": {
    "color_palette": {
      "primary": "#4f46e5",
      "secondary": "#64748b",
      "accent": "#f59e0b",
      "background": "#f8fafc",
      "surface": "#ffffff"
    },
    "typography": {
      "heading_font": "Inter",
      "body_font": "Inter",
      "scale": "1.25"
    },
    "layout": "sidebar-main",
    "theme": "light",
    "component_style": "rounded-2xl shadow-sm border border-slate-200"
  },
  "_readmeHash": "ad7d72689b4fe1d67f4d2afa05324fd6"
}
