{
  "project_name": "PersonalPortfolio",
  "architecture_stack": {
    "backend": "Laravel",
    "frontend": "Livewire + Tailwind",
    "database": "MySQL"
  },
  "models": ["User", "Project", "Skill", "Message"],
  "schema": {
    "User": { "name": "string", "email": "string", "password": "string", "bio": "text" },
    "Project": { "user_id": "integer", "title": "string", "description": "text", "image_url": "string", "link": "string" },
    "Skill": { "user_id": "integer", "name": "string", "proficiency": "integer" },
    "Message": { "name": "string", "email": "string", "content": "text", "is_read": "boolean" }
  },
  "relationships": [
    { "model": "User", "type": "hasMany", "target": "Project" },
    { "model": "User", "type": "hasMany", "target": "Skill" },
    { "model": "Project", "type": "belongsTo", "target": "User" },
    { "model": "Skill", "type": "belongsTo", "target": "User" }
  ],
  "presentation_layer": {
    "layouts": ["portfolio", "admin"],
    "components": [
      {
        "name": "portfolio-homepage",
        "state": ["projects", "skills", "userBio"],
        "events_listened": []
      },
      {
        "name": "contact-form",
        "state": ["name", "email", "content", "successMessage"],
        "events_listened": []
      },
      {
        "name": "admin-message-inbox",
        "state": ["messages", "unreadCount"],
        "events_listened": ["messageReceived"]
      }
    ]
  },
  "business_logic": {
    "roles": ["admin"],
    "policies": [
      "ProjectPolicy: Only admin can manage portfolio content"
    ],
    "validation_rules": {
      "Message": ["name:required|string", "email:required|email", "content:required|string"],
      "Project": ["title:required|string", "image_url:nullable|url"]
    }
  },
  "integrations": [],
  "testing": {
    "feature_tests": ["PublicPortfolioViewTest", "ContactFormSubmissionTest"],
    "unit_tests": ["AdminAccessTest"]
  }
}
