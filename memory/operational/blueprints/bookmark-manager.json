{
  "project_name": "bookmark-manager",
  "models": [
    "User",
    "Bookmark"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text"
    },
    "Bookmark": {
      "title": "string",
      "url": "string",
      "user_id": "integer"
    }
  },
  "migrations": [
    "create_users_table",
    "create_bookmarks_table"
  ],
  "livewire_components": [
    "bookmark-list",
    "bookmark-form"
  ],
  "seeders": [
    "UserSeeder",
    "BookmarkSeeder"
  ],
  "factories": [
    "UserFactory",
    "BookmarkFactory"
  ],
  "routes": [
    "/dashboard",
    "/bookmarks"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "Bookmark"
    }
  ]
}
