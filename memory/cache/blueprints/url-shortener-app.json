{
  "project_name": "url-shortener-app",
  "models": [
    "Url",
    "User",
    "ShortLink"
  ],
  "schema": {
    "Url": {
      "original_url": "string",
      "short_url": "string",
      "user_id": "integer",
      "created_at": "datetime",
      "updated_at": "datetime"
    },
    "User": {
      "email": "string",
      "password": "string",
      "created_at": "datetime",
      "updated_at": "datetime"
    },
    "ShortLink": {
      "short_url": "string",
      "target_url": "string",
      "created_at": "datetime",
      "updated_at": "datetime"
    }
  },
  "migrations": [
    "create_url_table",
    "create_user_table",
    "create_short_link_table"
  ],
  "livewire_components": [
    "ShortLinkComponent",
    "UserComponent"
  ],
  "seeders": [
    "UrlSeeder",
    "UserSeeder",
    "ShortLinkSeeder"
  ],
  "factories": [
    "UrlFactory",
    "UserFactory",
    "ShortLinkFactory"
  ],
  "routes": [
    "/dashboard",
    "/shortlink",
    "/user"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "Url",
      "type": "belongsTo",
      "target": "User",
      "foreignKey": "user_id"
    },
    {
      "model": "Url",
      "type": "hasMany",
      "target": "ShortLink",
      "foreignKey": "url_id"
    },
    {
      "model": "ShortLink",
      "type": "belongsTo",
      "target": "Url",
      "foreignKey": "url_id"
    }
  ]
}
