{
  "project_name": "notes-app-tagging",
  "models": [
    "User",
    "Note",
    "Tag"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text"
    },
    "Note": {
      "title": "string",
      "content": "string",
      "user_id": "integer",
      "tags": "json"
    },
    "Tag": {
      "name": "string"
    }
  },
  "migrations": [
    "create_users_table",
    "create_notes_table",
    "create_tags_table"
  ],
  "livewire_components": [
    "note-list",
    "note-detail",
    "tag-list"
  ],
  "seeders": [
    "UserSeeder",
    "NoteSeeder",
    "TagSeeder"
  ],
  "factories": [
    "UserFactory",
    "NoteFactory",
    "TagFactory"
  ],
  "routes": [
    "/dashboard",
    "/notes",
    "/tags"
  ],
  "pivot_tables": [
    "note_tags"
  ],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "Note"
    },
    {
      "model": "Note",
      "type": "belongsToMany",
      "target": "Tag",
      "through": "note_tags"
    },
    {
      "model": "Tag",
      "type": "belongsToMany",
      "target": "Note"
    }
  ]
}
