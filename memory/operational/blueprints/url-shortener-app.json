{
  "project_name": "url-shortener-app",
  "architecture_stack": {
    "backend": "Laravel",
    "frontend": "Livewire + Tailwind",
    "database": "MySQL"
  },
  "models": [
    "User",
    "ShortenedUrl"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text"
    },
    "ShortenedUrl": {
      "user_id": "integer",
      "url": "string",
      "shortened_url": "string"
    }
  },
  "migrations": [
    "create_users_table",
    "create_shortened_urls_table"
  ],
  "livewire_components": [
    "user-profile",
    "shortened-url-preview"
  ],
  "seeders": [
    "UserSeeder",
    "ShortenedUrlSeeder"
  ],
  "factories": [
    "UserFactory",
    "ShortenedUrlFactory"
  ],
  "routes": [
    "/dashboard",
    "/shortened"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "ShortenedUrl"
    }
  ],
  "presentation_layer": {
    "layouts": [
      "app",
      "guest",
      "admin"
    ],
    "components": [
      {
        "name": "user-profile",
        "state": [
          "user",
          "profile"
        ],
        "events_listened": [
          "userUpdated"
        ]
      },
      {
        "name": "shortened-url-preview",
        "state": [
          "shortenedUrl",
          "preview"
        ],
        "events_listened": [
          "shortenedUrlClicked"
        ]
      }
    ]
  },
  "business_logic": {
    "roles": [
      "admin",
      "user"
    ],
    "policies": [
      "ShortenedUrlPolicy: User can only edit own shortened url"
    ],
    "validation_rules": {
      "User": [
        "email:required|unique"
      ],
      "ShortenedUrl": [
        "url:required|unique"
      ]
    }
  },
  "integrations": [
    "Mailgun",
    "S3"
  ],
  "testing": {
    "feature_tests": [
      "UserRegistrationTest",
      "CreateShortenedUrlTest"
    ],
    "unit_tests": [
      "ShortenedUrlStatusCalculationTest"
    ]
  }
}
