{
  "project_name": "bookmark-manager",
  "architecture_stack": {
    "backend": "Laravel",
    "frontend": "Livewire + Tailwind",
    "database": "MySQL"
  },
  "models": [
    "User",
    "Bookmark"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text"
    },
    "Bookmark": {
      "user_id": "integer",
      "title": "string",
      "url": "string",
      "description": "string"
    }
  },
  "migrations": [
    "create_users_table",
    "create_bookmarks_table"
  ],
  "livewire_components": [
    "user-profile",
    "bookmark-list",
    "bookmark-form"
  ],
  "seeders": [
    "UserSeeder",
    "BookmarkSeeder"
  ],
  "factories": [
    "UserFactory",
    "BookmarkFactory"
  ],
  "routes": [
    "/dashboard",
    "/bookmarks"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "Bookmark"
    }
  ],
  "presentation_layer": {
    "layouts": [
      "app",
      "guest",
      "admin"
    ],
    "components": [
      {
        "name": "user-profile",
        "state": [
          "user",
          "profile"
        ],
        "events_listened": [
          "userUpdated"
        ]
      },
      {
        "name": "bookmark-list",
        "state": [
          "bookmarks",
          "searchQuery"
        ],
        "events_listened": [
          "bookmarkCreated"
        ]
      },
      {
        "name": "bookmark-form",
        "state": [
          "bookmark",
          "form"
        ],
        "events_listened": [
          "bookmarkUpdated",
          "bookmarkDeleted"
        ]
      }
    ]
  },
  "business_logic": {
    "roles": [
      "admin",
      "user"
    ],
    "policies": [
      "BookmarkPolicy: User can only edit own bookmark"
    ],
    "validation_rules": {
      "User": [
        "email:required|unique"
      ],
      "Bookmark": [
        "title:required",
        "url:required"
      ]
    }
  },
  "integrations": [
    "Mailgun",
    "S3"
  ],
  "testing": {
    "feature_tests": [
      "UserRegistrationTest",
      "CreateBookmarkTest"
    ],
    "unit_tests": [
      "BookmarkStatusCalculationTest"
    ]
  }
}
