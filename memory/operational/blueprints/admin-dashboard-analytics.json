{
  "project_name": "admin-dashboard-analytics",
  "architecture_stack": {
    "backend": "Laravel",
    "frontend": "Livewire + Tailwind",
    "database": "MySQL"
  },
  "models": ["User", "Report", "ActivityLog"],
  "schema": {
    "User": { "name": "string", "email": "string", "password": "string", "role": "string" },
    "Report": { "title": "string", "data": "json", "user_id": "integer", "generated_at": "datetime" },
    "ActivityLog": { "user_id": "integer", "action": "string", "description": "text", "created_at": "datetime" }
  },
  "relationships": [
    { "model": "User", "type": "hasMany", "target": "Report" },
    { "model": "User", "type": "hasMany", "target": "ActivityLog" },
    { "model": "Report", "type": "belongsTo", "target": "User" },
    { "model": "ActivityLog", "type": "belongsTo", "target": "User" }
  ],
  "presentation_layer": {
    "layouts": ["admin", "auth"],
    "components": [
      {
        "name": "dashboard-overview",
        "state": ["totalUsers", "recentActivity", "chartData"],
        "events_listened": ["reportGenerated", "userActivityLogged"]
      },
      {
        "name": "report-generator",
        "state": ["dateRange", "reportType", "isGenerating"],
        "events_listened": []
      },
      {
        "name": "activity-feed",
        "state": ["logs", "filter"],
        "events_listened": ["userActivityLogged"]
      }
    ]
  },
  "business_logic": {
    "roles": ["super_admin", "admin", "viewer"],
    "policies": [
      "ReportPolicy: Viewer can only view, Admin can generate",
      "UserPolicy: Only Super Admin can manage users"
    ],
    "validation_rules": {
      "Report": ["title:required|string|max:255", "dateRange:required|array"]
    }
  },
  "integrations": ["Google Analytics API", "Pusher"],
  "testing": {
    "feature_tests": ["DashboardAccessTest", "GenerateReportTest"],
    "unit_tests": ["AnalyticsDataAggregationTest", "RolePermissionTest"]
  }
}
