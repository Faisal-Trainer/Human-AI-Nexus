{
  "project_name": "expense-tracker",
  "models": [
    "Expense",
    "Category",
    "User"
  ],
  "migrations": [
    "create_expense_table",
    "create_category_table",
    "create_user_table"
  ],
  "livewire_components": [
    "DashboardComponent",
    "ExpenseFormComponent",
    "CategoryFormComponent",
    "UserFormComponent"
  ],
  "seeders": [
    "ExpenseSeeder",
    "CategorySeeder",
    "UserSeeder"
  ],
