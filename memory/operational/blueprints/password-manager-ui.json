{
  "project_name": "PasswordManager",
  "models": [
    "User",
    "Password"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "hash"
    },
    "Password": {
      "user_id": "integer",
      "value": "string",
      "created_at": "datetime",
      "updated_at": "datetime"
    }
  },
  "migrations": [
    "create_users_table",
    "create_passwords_table"
  ],
  "livewire_components": [
    "user-profile",
    "password-form"
  ],
  "seeders": [
    "UserSeeder",
    "PasswordSeeder"
  ],
  "factories": [
    "UserFactory",
    "PasswordFactory"
  ],
  "routes": [
    "/dashboard",
    "/passwords"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "Password"
    }
  ]
}
