{
  "project_name": "PersonalPortfolio",
  "models": [
    "User",
    "Project",
    "Task"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text"
    },
    "Project": {
      "title": "string",
      "description": "string",
      "user_id": "integer"
    },
    "Task": {
      "title": "string",
      "description": "string",
      "project_id": "integer"
    }
  },
  "migrations": [
    "create_users_table",
    "create_projects_table",
    "create_tasks_table"
  ],
  "livewire_components": [
    "user-profile",
    "project-list",
    "task-list"
  ],
  "seeders": [
    "UserSeeder",
    "ProjectSeeder",
    "TaskSeeder"
  ],
  "factories": [
    "UserFactory",
    "ProjectFactory",
    "TaskFactory"
  ],
  "routes": [
    "/dashboard",
    "/project",
    "/task"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "Project"
    },
    {
      "model": "Project",
      "type": "hasMany",
      "target": "Task"
    }
  ]
}
