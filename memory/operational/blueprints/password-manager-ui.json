{
  "project_name": "PasswordManager",
  "architecture_stack": {
    "backend": "Laravel",
    "frontend": "Livewire + Tailwind",
    "database": "MySQL"
  },
  "models": ["User", "Password", "Folder"],
  "schema": {
    "User": { "name": "string", "email": "string", "password": "string" },
    "Folder": { "user_id": "integer", "name": "string" },
    "Password": { "user_id": "integer", "folder_id": "integer", "title": "string", "username": "string", "encrypted_password": "text", "website_url": "string" }
  },
  "relationships": [
    { "model": "User", "type": "hasMany", "target": "Password" },
    { "model": "User", "type": "hasMany", "target": "Folder" },
    { "model": "Folder", "type": "hasMany", "target": "Password" },
    { "model": "Password", "type": "belongsTo", "target": "Folder" },
    { "model": "Password", "type": "belongsTo", "target": "User" }
  ],
  "presentation_layer": {
    "layouts": ["app", "guest"],
    "components": [
      {
        "name": "vault-dashboard",
        "state": ["passwords", "folders", "searchQuery"],
        "events_listened": ["passwordSaved", "passwordDeleted"]
      },
      {
        "name": "password-generator-modal",
        "state": ["length", "includeNumbers", "includeSymbols", "generatedPassword"],
        "events_listened": []
      },
      {
        "name": "password-editor",
        "state": ["title", "username", "password", "website_url", "folder_id"],
        "events_listened": ["editPassword"]
      }
    ]
  },
  "business_logic": {
    "roles": ["user"],
    "policies": [
      "PasswordPolicy: User can only access and decrypt own passwords"
    ],
    "validation_rules": {
      "Password": ["title:required|string", "encrypted_password:required|string"]
    }
  },
  "integrations": [],
  "testing": {
    "feature_tests": ["VaultAccessTest", "PasswordEncryptionTest"],
    "unit_tests": ["PasswordStrengthGenerationTest"]
  }
}
