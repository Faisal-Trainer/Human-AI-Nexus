{
  "project_name": "url-shortener-app",
  "models": [
    "User",
    "ShortURL"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text"
    },
    "ShortURL": {
      "original_url": "string",
      "shortened_url": "string",
      "user_id": "integer"
    }
  },
  "migrations": [
    "create_users_table",
    "create_short_urls_table",
    "create_user_short_url_table"
  ],
  "livewire_components": [
    "short-url-list",
    "short-url-create"
  ],
  "seeders": [
    "UserSeeder",
    "ShortURLSeeder",
    "UserShortURLSeeder"
  ],
  "factories": [
    "UserFactory",
    "ShortURLFactory",
    "UserShortURLFactory"
  ],
  "routes": [
    "/dashboard",
    "/short-url",
    "/short-url/create"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "ShortURL"
    },
    {
      "model": "ShortURL",
      "type": "belongsTo",
      "target": "User"
    }
  ]
}
