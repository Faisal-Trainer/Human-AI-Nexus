{
  "project_name": "expense-tracker",
  "models": [
    "User",
    "Expense",
    "BudgetCategory"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string:unique",
      "password": "text",
      "role": "string:default(user)"
    },
    "Expense": {
      "title": "string",
      "amount": "decimal",
      "description": "text",
      "user_id": "foreignUuid:constrained"
    },
    "BudgetCategory": {
      "name": "string",
      "color": "string",
      "user_id": "foreignUuid:constrained"
    }
  },
  "migrations": [
    "create_users_table",
    "create_expenses_table",
    "create_budget_categories_table"
  ],
  "livewire_components": [
    "expense-card",
    "expense-list",
    "expense-form"
  ],
  "seeders": [
    "UserSeeder",
    "ExpenseSeeder",
    "BudgetCategorySeeder"
  ],
  "factories": [
    "UserFactory",
    "ExpenseFactory",
    "BudgetCategoryFactory"
  ],
  "routes": [
    "/dashboard",
    "/expenses",
    "/budgets"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "Expense"
    },
    {
      "model": "User",
      "type": "hasMany",
      "target": "BudgetCategory"
    }
  ],
  "middleware": [
    "auth",
    "verified",
    "throttle:60,1"
  ],
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/api/v1/dashboard",
      "controller": "DashboardController@index",
      "middleware": [
        "auth:sanctum"
      ]
    },
    {
      "method": "POST",
      "path": "/api/v1/expenses",
      "controller": "ExpenseController@store",
      "middleware": [
        "auth:sanctum"
      ]
    }
  ],
  "security_policies": {
    "roles": [
      "admin",
      "user"
    ],
    "permissions": [
      "view-dashboard",
      "manage-expenses",
      "manage-budgets"
    ],
    "rate_limiting": {
      "api": "60,1",
      "auth": "5,1"
    },
    "middleware_map": {
      "/admin/*": [
        "auth",
        "role:admin"
      ],
      "/dashboard": [
        "auth",
        "verified"
      ]
    }
  },
  "async_jobs": [
    {
      "name": "ProcessExpenseTask",
      "queue": "default",
      "retry": 3,
      "backoff": 60
    }
  ],
  "ui_design_system": {
    "color_palette": {
      "primary": "#4f46e5",
      "secondary": "#64748b",
      "accent": "#f59e0b",
      "background": "#f8fafc",
      "surface": "#ffffff"
    },
    "typography": {
      "heading_font": "Inter",
      "body_font": "Inter",
      "scale": "1.25"
    },
    "layout": "sidebar-main",
    "theme": "light",
    "component_style": "rounded-2xl shadow-sm border border-slate-200"
  },
  "_readmeHash": "d64a9d43ee9ed35b9940a0f9a1d7de39"
}
