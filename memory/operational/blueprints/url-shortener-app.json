{
  "project_name": "url-shortener-app",
  "models": [
    "User",
    "Url"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text"
    },
    "Url": {
      "short_code": "string",
      "full_url": "string",
      "visits": "integer"
    }
  },
  "migrations": [
    "create_users_table",
    "create_urls_table"
  ],
  "livewire_components": [
    "user-profile",
    "url-shortener"
  ],
  "seeders": [
    "UserSeeder",
    "UrlSeeder"
  ],
  "factories": [
    "UserFactory",
    "UrlFactory"
  ],
  "routes": [
    "/dashboard",
    "/url-shortener"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "Url"
    }
  ]
}
