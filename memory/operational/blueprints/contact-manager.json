{
  "project_name": "contact-manager",
  "architecture_stack": {
    "backend": "Laravel",
    "frontend": "Livewire + Tailwind",
    "database": "MySQL"
  },
  "models": [
    "User",
    "Contact"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text"
    },
    "Contact": {
      "name": "string",
      "email": "string",
      "phone_number": "string",
      "address": "string"
    }
  },
  "migrations": [
    "create_users_table",
    "create_contacts_table"
  ],
  "livewire_components": [
    "user-profile",
    "contact-form"
  ],
  "seeders": [
    "UserSeeder",
    "ContactSeeder"
  ],
  "factories": [
    "UserFactory",
    "ContactFactory"
  ],
  "routes": [
    "/dashboard",
    "/contacts"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "Contact"
    },
    {
      "model": "Contact",
      "type": "belongsTo",
      "target": "User"
    }
  ],
  "presentation_layer": {
    "layouts": [
      "app",
      "guest",
      "admin"
    ],
    "components": [
      {
        "name": "post-list",
        "state": [
          "posts",
          "searchQuery"
        ],
        "events_listened": [
          "postCreated"
        ]
      },
      {
        "name": "contact-form",
        "state": [
          "contact",
          "contactErrors"
        ],
        "events_listened": [
          "contactFormSubmitted"
        ]
      }
    ]
  },
  "business_logic": {
    "roles": [
      "admin",
      "user"
    ],
    "policies": [
      "ContactPolicy: User can only edit own contact"
    ],
    "validation_rules": {
      "User": [
        "email:required|unique"
      ],
      "Contact": [
        "email:required|unique"
      ]
    }
  },
  "integrations": [
    "Mailgun",
    "S3"
  ],
  "testing": {
    "feature_tests": [
      "UserRegistrationTest",
      "CreateContactTest"
    ],
    "unit_tests": [
      "ContactStatusCalculationTest"
    ]
  }
}
