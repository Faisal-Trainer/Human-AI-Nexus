{
  "project_name": "NotesAppTagging",
  "models": [
    "User",
    "Note",
    "Tag"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text"
    },
    "Note": {
      "title": "string",
      "content": "text",
      "user_id": "integer",
      "tags": "json"
    },
    "Tag": {
      "name": "string",
      "notes": "json"
    }
  },
  "migrations": [
    "create_users_table",
    "create_notes_table",
    "create_tags_table"
  ],
  "livewire_components": [
    "note-list",
    "tag-list",
    "note-editor"
  ],
  "seeders": [
    "UserSeeder",
    "NoteSeeder",
    "TagSeeder"
  ],
  "factories": [
    "UserFactory",
    "NoteFactory",
    "TagFactory"
  ],
  "routes": [
    "/dashboard",
    "/notes",
    "/tags",
    "/note/create",
    "/note/edit",
    "/note/show",
    "/note/delete",
    "/tag/create",
    "/tag/edit",
    "/tag/show",
    "/tag/delete"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "Note"
    },
    {
      "model": "Note",
      "type": "belongsToMany",
      "target": "Tag",
      "pivot_table": "note_tags"
    },
    {
      "model": "Tag",
      "type": "belongsToMany",
      "target": "Note",
      "pivot_table": "note_tags"
    }
  ]
}
