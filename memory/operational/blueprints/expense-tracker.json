{
  "project_name": "expense-tracker",
  "architecture_stack": {
    "backend": "Laravel",
    "frontend": "Livewire + Tailwind",
    "database": "MySQL"
  },
  "models": [
    "User",
    "Expense"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text"
    },
    "Expense": {
      "name": "string",
      "amount": "decimal",
      "user_id": "integer",
      "created_at": "DateTime",
      "updated_at": "DateTime"
    }
  },
  "migrations": [
    "create_users_table",
    "create_expenses_table"
  ],
  "livewire_components": [
    "user-profile",
    "expense-list",
    "expense-form"
  ],
  "seeders": [
    "UserSeeder",
    "ExpenseSeeder"
  ],
  "factories": [
    "UserFactory",
    "ExpenseFactory"
  ],
  "routes": [
    "/dashboard",
    "/expenses"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "Expense"
    }
  ],
  "presentation_layer": {
    "layouts": [
      "app",
      "guest",
      "admin"
    ],
    "components": [
      {
        "name": "user-profile",
        "state": [
          "user",
          "profile"
        ],
        "events_listened": [
          "userUpdated"
        ]
      },
      {
        "name": "expense-list",
        "state": [
          "expenses",
          "searchQuery"
        ],
        "events_listened": [
          "expenseCreated"
        ]
      },
      {
        "name": "expense-form",
        "state": [
          "expense",
          "form"
        ],
        "events_listened": [
          "expenseUpdated",
          "expenseDeleted"
        ]
      }
    ]
  },
  "business_logic": {
    "roles": [
      "admin",
      "user"
    ],
    "policies": [
      "ExpensePolicy: User can only edit own expense"
    ],
    "validation_rules": {
      "User": [
        "email:required|unique"
      ],
      "Expense": [
        "name:required",
        "amount:required"
      ]
    }
  },
  "integrations": [
    "Mailgun",
    "S3"
  ],
  "testing": {
    "feature_tests": [
      "UserRegistrationTest",
      "CreateExpenseTest"
    ],
    "unit_tests": [
      "ExpenseStatusCalculationTest"
    ]
  }
}
