    "create_table_tags_table",
    "create_table_relations_table"
  ],
  "livewire_components": [
    "NoteIndexComponent",
    "NoteShowComponent",
    "TagListComponent",
    "TagCreateComponent",
    "TagEditComponent"
  ],
  "seeders": [
