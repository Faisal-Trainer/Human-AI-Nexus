{
  "project_name": "daily-journal",
  "models": [
    "User",
    "JournalEntry"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text",
      "role": "enum('admin', 'user')"
    },
    "JournalEntry": {
      "user_id": "integer",
      "title": "string",
      "content": "text",
      "created_at": "datetime",
      "updated_at": "datetime"
    }
  },
  "migrations": [
    "create_users_table",
    "create_journal_entries_table"
  ],
  "livewire_components": [
    "journal-entry",
    "user-dashboard"
  ],
  "seeders": [
    "UserSeeder",
    "JournalEntrySeeder"
  ],
  "factories": [
    "UserFactory",
    "JournalEntryFactory"
  ],
  "routes": [
    "/dashboard",
    "/journal"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "belongsTo",
      "target": "JournalEntry"
    },
    {
      "model": "JournalEntry",
      "type": "hasMany",
      "target": "User"
    }
  ]
}
