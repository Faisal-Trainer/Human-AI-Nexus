{
  "project_name": "notes-app-tagging",
  "models": [
    "User",
    "Note"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text"
    },
    "Note": {
      "title": "string",
      "content": "text",
      "user_id": "integer",
      "tags": "json",
      "created_at": "datetime",
      "updated_at": "datetime"
    }
  },
  "migrations": [
    "create_users_table",
    "create_notes_table",
    "create_tags_table",
    "create_notes_tags_table"
  ],
  "livewire_components": [
    "user-profile",
    "note-form"
  ],
  "seeders": [
    "UserSeeder",
    "NoteSeeder",
    "TagSeeder"
  ],
  "factories": [
    "UserFactory",
    "NoteFactory",
    "TagFactory"
  ],
  "routes": [
    "/dashboard",
    "/notes/create",
    "/notes/edit",
    "/tags/create",
    "/tags/edit"
  ],
  "pivot_tables": [
    "notes_tags"
  ],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "Note"
    },
    {
      "model": "Note",
      "type": "belongsToMany",
      "target": "Tag",
      "pivot_table": "notes_tags"
    }
  ]
}
