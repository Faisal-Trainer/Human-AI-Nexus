{
  "project_name": "crm-sederhana",
  "models": [
    "User",
    "DomainSpecificModel",
    "DomainSpecificModel2"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string:unique",
      "password": "text",
      "role": "string:default(user)"
    },
    "DomainSpecificModel": {
      "title": "string",
      "description": "text:nullable",
      "user_id": "foreignUuid:constrained"
    },
    "DomainSpecificModel2": {
      "name": "string",
      "status": "string:default(active)"
    }
  },
  "migrations": [
    "create_users_table",
    "create_domain_specific_models_table",
    "create_domain_specific_models_table2"
  ],
  "livewire_components": [
    "feature-manager",
    "feature-dashboard",
    "feature-list"
  ],
  "seeders": [
    "UserSeeder",
    "DomainSpecificModelSeeder",
    "DomainSpecificModel2Seeder"
  ],
  "factories": [
    "UserFactory",
    "DomainSpecificModelFactory",
    "DomainSpecificModel2Factory"
  ],
  "routes": [
    "/dashboard",
    "/features"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "DomainSpecificModel"
    },
    {
      "model": "DomainSpecificModel",
      "type": "belongsTo",
      "target": "User"
    },
    {
      "model": "DomainSpecificModel2",
      "type": "hasMany",
      "target": "User"
    }
  ],
  "middleware": [
    "auth",
    "verified",
    "throttle:60,1"
  ],
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/api/v1/features",
      "controller": "FeatureController@index",
      "middleware": [
        "auth:sanctum"
      ]
    },
    {
      "method": "POST",
      "path": "/api/v1/features",
      "controller": "FeatureController@store",
      "middleware": [
        "auth:sanctum"
      ]
    }
  ],
  "security_policies": {
    "roles": [
      "admin",
      "user"
    ],
    "permissions": [
      "manage-items",
      "view-dashboard"
    ],
    "rate_limiting": {
      "api": "60,1",
      "auth": "5,1"
    },
    "middleware_map": {
      "/admin/*": [
        "auth",
        "role:admin"
      ],
      "/dashboard": [
        "auth",
        "verified"
      ]
    }
  },
  "async_jobs": [
    {
      "name": "ProcessDomainTask",
      "queue": "default",
      "retry": 3,
      "backoff": 60
    }
  ],
  "ui_design_system": {
    "color_palette": {
      "primary": "#4f46e5",
      "secondary": "#64748b",
      "accent": "#f59e0b",
      "background": "#f8fafc",
      "surface": "#ffffff"
    },
    "typography": {
      "heading_font": "Inter",
      "body_font": "Inter",
      "scale": "1.25"
    },
    "layout": "sidebar-main",
    "theme": "light",
    "component_style": "rounded-2xl shadow-sm border border-slate-200"
  },
  "_readmeHash": "78538d6f3d37eab194fea345109f8bc9"
}
