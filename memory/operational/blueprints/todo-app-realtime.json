{
  "project_name": "TodoAppRealtime",
  "models": [
    "User",
    "Todo"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text"
    },
    "Todo": {
      "title": "string",
      "description": "string",
      "completed": "boolean"
    }
  },
  "migrations": [
    "create_users_table",
    "create_todos_table"
  ],
  "livewire_components": [
    "todo-list",
    "todo-detail"
  ],
  "seeders": [
    "UserSeeder",
    "TodoSeeder"
  ],
  "factories": [
    "UserFactory",
    "TodoFactory"
  ],
  "routes": [
    "/home",
    "/todo"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "Todo"
    },
    {
      "model": "Todo",
      "type": "belongsTo",
      "target": "User"
    }
  ]
}
