{
  "project_name": "habit-tracker",
  "models": [
    "User",
    "Habit"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text"
    },
    "Habit": {
      "name": "string",
      "user_id": "integer",
      "created_at": "timestamp",
      "updated_at": "timestamp"
    }
  },
  "migrations": [
    "create_users_table",
    "create_habits_table",
    "create_user_habit_pivot_table"
  ],
  "livewire_components": [
    "user-profile",
    "habit-list"
  ],
  "seeders": [
    "UserSeeder",
    "HabitSeeder"
  ],
  "factories": [
    "UserFactory",
    "HabitFactory"
  ],
  "routes": [
    "/dashboard",
    "/habits"
  ],
  "pivot_tables": [
    "user_habit"
  ],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "Habit"
    },
    {
      "model": "Habit",
      "type": "belongsTo",
      "target": "User"
    }
  ]
}
