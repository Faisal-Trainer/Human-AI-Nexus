{
  "project_name": "url-shortener-app",
  "models": [
    "User",
    "ShortenedUrl"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text"
    },
    "ShortenedUrl": {
      "shortened_url": "string",
      "original_url": "string",
      "user_id": "integer",
      "created_at": "datetime",
      "updated_at": "datetime"
    }
  },
  "migrations": [
    "create_users_table",
    "create_shortened_urls_table",
    "add_user_id_to_shortened_urls_table"
  ],
  "livewire_components": [
    "user-profile",
    "shortened-url"
  ],
  "seeders": [
    "UserSeeder",
    "ShortenedUrlSeeder"
  ],
  "factories": [
    "UserFactory",
    "ShortenedUrlFactory"
  ],
  "routes": [
    "/dashboard",
    "/shortened-url"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "ShortenedUrl"
    }
  ]
}
