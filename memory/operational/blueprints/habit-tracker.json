{
  "project_name": "habit-tracker",
  "architecture_stack": {
    "backend": "Laravel",
    "frontend": "Livewire + Tailwind",
    "database": "MySQL"
  },
  "models": ["User", "Habit", "HabitLog"],
  "schema": {
    "User": { "name": "string", "email": "string", "password": "string" },
    "Habit": { "user_id": "integer", "name": "string", "description": "text", "frequency": "string", "goal": "integer" },
    "HabitLog": { "habit_id": "integer", "date": "date", "completed": "boolean" }
  },
  "relationships": [
    { "model": "User", "type": "hasMany", "target": "Habit" },
    { "model": "Habit", "type": "belongsTo", "target": "User" },
    { "model": "Habit", "type": "hasMany", "target": "HabitLog" },
    { "model": "HabitLog", "type": "belongsTo", "target": "Habit" }
  ],
  "presentation_layer": {
    "layouts": ["app", "guest"],
    "components": [
      {
        "name": "habit-dashboard",
        "state": ["habits", "currentWeek"],
        "events_listened": ["habitLogged", "habitCreated"]
      },
      {
        "name": "habit-tracker-row",
        "state": ["habit", "logs"],
        "events_listened": []
      },
      {
        "name": "habit-form",
        "state": ["name", "description", "frequency", "goal"],
        "events_listened": []
      }
    ]
  },
  "business_logic": {
    "roles": ["user"],
    "policies": [
      "HabitPolicy: User can only manage own habits"
    ],
    "validation_rules": {
      "Habit": ["name:required|string|max:255", "frequency:required|in:daily,weekly,monthly"]
    }
  },
  "integrations": [],
  "testing": {
    "feature_tests": ["CreateHabitTest", "LogHabitCompletionTest"],
    "unit_tests": ["StreakCalculationTest"]
  }
}
