{
  "project_name": "expense-tracker",
  "models": [
    "User",
    "Expense"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text"
    },
    "Expense": {
      "description": "string",
      "amount": "decimal",
      "category": "string",
      "user_id": "integer"
    }
  },
  "migrations": [
    "create_users_table",
    "create_expenses_table"
  ],
  "livewire_components": [
    "user-profile",
    "expense-list"
  ],
  "seeders": [
    "UserSeeder",
    "ExpenseSeeder"
  ],
  "factories": [
    "UserFactory",
    "ExpenseFactory"
  ],
  "routes": [
    "/dashboard",
    "/expense-list"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "Expense"
    }
  ]
}
