{
  "project_name": "Todo-App-Realtime",
  "models": [
    "User",
    "Task"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text"
    },
    "Task": {
      "title": "string",
      "description": "text",
      "completed": "boolean",
      "user_id": "foreign key"
    }
  },
  "migrations": [
    "create_users_table",
    "create_tasks_table"
  ],
  "livewire_components": [
    "task-list",
    "task-create"
  ],
  "seeders": [
    "UserSeeder",
    "TaskSeeder"
  ],
  "factories": [
    "UserFactory",
    "TaskFactory"
  ],
  "routes": [
    "/dashboard",
    "/tasks"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "Task"
    }
  ]
}
