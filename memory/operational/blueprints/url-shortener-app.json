{
  "project_name": "url-shortener-app",
  "architecture_stack": {
    "backend": "Laravel",
    "frontend": "Livewire + Tailwind",
    "database": "MySQL"
  },
  "models": [
    "User",
    "YourRealModelName"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text"
    },
    "YourRealModelName": {
      "url": "string",
      "shortened_url": "string",
      "created_at": "datetime",
      "updated_at": "datetime"
    }
  },
  "migrations": [
    "create_users_table",
    "create_your_real_tables_table",
    "create_shortened_urls_table"
  ],
  "livewire_components": [
    "user-profile",
    "your-real-component"
  ],
  "seeders": [
    "UserSeeder",
    "YourRealModelSeeder",
    "ShortenedUrlSeeder"
  ],
  "factories": [
    "UserFactory",
    "YourRealModelFactory",
    "ShortenedUrlFactory"
  ],
  "routes": [
    "/dashboard",
    "/your-real-route"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "YourRealModelName"
    }
  ],
  "presentation_layer": {
    "layouts": [
      "app",
      "guest",
      "admin"
    ],
    "components": [
      {
        "name": "post-list",
        "state": [
          "posts",
          "searchQuery"
        ],
        "events_listened": [
          "postCreated"
        ]
      },
      {
        "name": "your-real-component",
        "state": [
          "your-real-data"
        ],
        "events_listened": [
          "your-real-event"
        ]
      }
    ]
  },
  "business_logic": {
    "roles": [
      "admin",
      "user"
    ],
    "policies": [
      "PostPolicy: User can only edit own post"
    ],
    "validation_rules": {
      "User": [
        "email:required|unique"
      ],
      "YourRealModelName": [
        "url:required"
      ]
    }
  },
  "integrations": [
    "Mailgun",
    "S3"
  ],
  "testing": {
    "feature_tests": [
      "UserRegistrationTest",
      "CreatePostTest"
    ],
    "unit_tests": [
      "PostStatusCalculationTest"
    ]
  }
}
