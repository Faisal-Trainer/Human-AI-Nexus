{
  "project_name": "todo-app-realtime",
  "architecture_stack": {
    "backend": "Laravel",
    "frontend": "Livewire + Tailwind",
    "database": "MySQL"
  },
  "models": [
    "User",
    "Todo"
  ],
  "schema": {
    "User": {
      "name": "string",
      "email": "string",
      "password": "text"
    },
    "Todo": {
      "title": "string",
      "description": "string",
      "completed": "boolean",
      "user_id": "integer"
    }
  },
  "migrations": [
    "create_users_table",
    "create_todos_table"
  ],
  "livewire_components": [
    "user-profile",
    "todo-list",
    "todo-item"
  ],
  "seeders": [
    "UserSeeder",
    "TodoSeeder"
  ],
  "factories": [
    "UserFactory",
    "TodoFactory"
  ],
  "routes": [
    "/dashboard",
    "/todo"
  ],
  "pivot_tables": [],
  "relationships": [
    {
      "model": "User",
      "type": "hasMany",
      "target": "Todo"
    }
  ],
  "presentation_layer": {
    "layouts": [
      "app",
      "guest",
      "admin"
    ],
    "components": [
      {
        "name": "user-profile",
        "state": [
          "user",
          "profile"
        ],
        "events_listened": [
          "userUpdated"
        ]
      },
      {
        "name": "todo-list",
        "state": [
          "todos",
          "searchQuery"
        ],
        "events_listened": [
          "todoCreated",
          "todoUpdated",
          "todoDeleted"
        ]
      },
      {
        "name": "todo-item",
        "state": [
          "todo",
          "item"
        ],
        "events_listened": [
          "itemUpdated"
        ]
      }
    ]
  },
  "business_logic": {
    "roles": [
      "admin",
      "user"
    ],
    "policies": [
      "TodoPolicy: User can only edit own todo"
    ],
    "validation_rules": {
      "User": [
        "email:required|unique"
      ],
      "Todo": [
        "title:required",
        "description:required",
        "completed:required"
      ]
    }
  },
  "integrations": [
    "Mailgun",
    "S3"
  ],
  "testing": {
    "feature_tests": [
      "UserRegistrationTest",
      "CreateTodoTest",
      "UpdateTodoTest",
      "DeleteTodoTest"
    ],
    "unit_tests": [
      "TodoStatusCalculationTest",
      "TodoItemStatusCalculationTest"
    ]
  }
}
